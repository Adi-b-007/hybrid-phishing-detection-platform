{
"manifest_version": 3,

"name": "Phishing Detection Shield",

"version": "1.0",

"description": "Detect phishing websites using ML",

"permissions": [
"activeTab",
"storage",
"tabs"
],

"host_permissions": [
"<all_urls>",
"http://127.0.0.1:5000/*"
],

"icons": {
"16": "icons/icon16.png",
"48": "icons/icon48.png",
"128": "icons/icon128.png"
},

"action": {
"default_popup": "popup.html",


"default_icon": {
  "16": "icons/icon16.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
}

},

"background": {
"service_worker": "background.js"
},
"content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }
]
}
